{
  "name": "magic-vacation",
  "version": "1.0.0",
  "description": "Личный проект «Таинственный отпуск» от HTML Academy",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@htmlacademy/editorconfig-cli": "3.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.4",
    "css-minimizer-webpack-plugin": "8.0.0",
    "eslint": "8.57.1",
    "eslint-config-htmlacademy": "10.0.1",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.6",
    "lodash": "4.18.1",
    "mini-css-extract-plugin": "2.10.2",
    "postcss-scss": "4.0.9",
    "posthtml": "0.16.7",
    "posthtml-include": "2.0.1",
    "posthtml-loader": "2.0.1",
    "posthtml-parser": "0.12.1",
    "sass": "1.99.0",
    "sass-loader": "16.0.7",
    "style-loader": "4.0.0",
    "stylelint": "16.26.1",
    "stylelint-config-htmlacademy": "4.4.0",
    "stylelint-scss": "7.0.0",
    "webpack": "5.105.4",
    "webpack-cli": "7.0.2",
    "webpack-dev-server": "5.2.3"
  },
  "scripts": {
    "editorconfig": "editorconfig-cli",
    "stylelint": "stylelint \"source/scss/**/*.scss\"",
    "test": "npm run editorconfig && npm run stylelint && eslint source/js/",
    "build": "webpack",
    "start": "webpack-dev-server --open"
  },
  "browserslist": [
    "last 2 versions",
    "Firefox ESR"
  ],
  "editorconfig-cli": [
    "*.json",
    "*.js",
    "source/*.html",
    "source/js/**/*.js",
    "source/img/**/*.svg",
    "source/scss/**/*.{sass,scss}"
  ],
  "dependencies": {
    "normalize.css": "8.0.1",
    "swiper": "12.1.3",
    "three": "0.183.2"
  }
}
